/*
 * Allwinner Technology CO., Ltd. sun8iw21p1 soc board.
 *
 * Antares board configuration
 */

/dts-v1/;

#include "sun8iw21p1.dtsi"

/{
	compatible = "allwinner,sun8iw21p1", "arm,sun8iw21p1", "allwinner,v851se";
	soc@03000000 {
		/* Disable WLAN module */
		wlan: wlan@0 {
			status = "disabled";
		};

		/* Disable video input subsystem - not used */
		vind0:vind@0 {
			vind0_clk = <200000000>;
			status = "disabled";

			csi2:csi@2 {
				pinctrl-names = "default","sleep";
				pinctrl-0 = <&ncsi_pins_a>;
				pinctrl-1 = <&ncsi_pins_b>;
				status = "disabled";
			};

			tdm0:tdm@0 {
				work_mode = <0>;
			};

			isp00:isp@0 {
				work_mode = <0>;
			};

			scaler00:scaler@0 {
				work_mode = <0>;
			};

			scaler10:scaler@4 {
				work_mode = <0>;
			};

			scaler20:scaler@8 {
				work_mode = <0>;
			};

			scaler30:scaler@12 {
				work_mode = <0>;
			};

			actuator0:actuator@0 {
				device_type = "actuator0";
				actuator0_name = "ad5820_act";
				actuator0_slave = <0x18>;
				actuator0_af_pwdn = <>;
				actuator0_afvdd = "afvcc-csi";
				actuator0_afvdd_vol = <2800000>;
				status = "disabled";
			};

			flash0:flash@0 {
				device_type = "flash0";
				flash0_type = <2>;
				flash0_en = <>;
				flash0_mode = <>;
				flash0_flvdd = "";
				flash0_flvdd_vol = <>;
				status = "disabled";
			};

			sensor0:sensor@0 {
				device_type = "sensor0";
				sensor0_mname = "gc2053_mipi";
				sensor0_twi_cci_id = <3>;
				sensor0_twi_addr = <0x6e>;
				sensor0_mclk_id = <0>;
				sensor0_pos = "rear";
				sensor0_isp_used = <1>;
				sensor0_fmt = <1>;
				sensor0_stby_mode = <0>;
				sensor0_vflip = <0>;
				sensor0_hflip = <0>;
				sensor0_iovdd-supply = <>;
				sensor0_iovdd_vol = <1800000>;
				sensor0_avdd-supply = <>;
				sensor0_avdd_vol = <2800000>;
				sensor0_dvdd-supply = <>;
				sensor0_dvdd_vol = <1200000>;
				sensor0_power_en = <>;
				sensor1_reset = <&pio PA 20 1 0 1 0>;
				sensor1_pwdn = <&pio PA 21 1 0 1 0>;
				sensor0_sm_hs = <>;
				sensor0_sm_vs = <>;
				flash_handle = <&flash0>;
				act_handle = <&actuator0>;
				status	= "disabled";
			};

			sensor1:sensor@1 {
				device_type = "sensor1";
				sensor1_mname = "imx386_mipi_2";
				sensor1_twi_cci_id = <0>;
				sensor1_twi_addr = <0x20>;
				sensor1_mclk_id = <1>;
				sensor1_pos = "front";
				sensor1_isp_used = <1>;
				sensor1_fmt = <1>;
				sensor1_stby_mode = <0>;
				sensor1_vflip = <0>;
				sensor1_hflip = <0>;
				sensor1_iovdd-supply = <>;
				sensor1_iovdd_vol = <1800000>;
				sensor1_avdd-supply = <>;
				sensor1_avdd_vol = <2800000>;
				sensor1_dvdd-supply = <>;
				sensor1_dvdd_vol = <1200000>;
				sensor1_power_en = <>;
				sensor1_reset = <&pio PA 20 1 0 1 0>;
				sensor1_pwdn = <&pio PA 21 1 0 1 0>;
				sensor1_sm_hs = <&pio PE 2 1 0 1 0>;
				sensor1_sm_vs = <&pio PE 3 1 0 1 0>;
				flash_handle = <>;
				act_handle = <>;
				status	= "disabled";
			};

			/* Disable all camera inputs */
			vinc00:vinc@0 {
				vinc0_csi_sel = <0>;
				vinc0_mipi_sel = <0>;
				vinc0_isp_sel = <0>;
				vinc0_isp_tx_ch_ = <0>;
				vinc0_tdm_rx_sel = <0>;
				vinc0_rear_sensor_sel = <0>;
				vinc0_front_sensor_sel = <0>;
				vinc0_sensor_list = <0>;
				work_mode = <0x0>;
				status = "disabled";
			};

			vinc01:vinc@1 {
				vinc1_csi_sel = <2>;
				vinc1_mipi_sel = <0xff>;
				vinc1_isp_sel = <1>;
				vinc1_isp_tx_ch = <1>;
				vinc1_tdm_rx_sel = <1>;
				vinc1_rear_sensor_sel = <0>;
				vinc1_front_sensor_sel = <0>;
				vinc1_sensor_list = <0>;
				status = "disabled";
			};
		};
	};
};

&npu {
	clock-frequency = <348000000>;/*0.93V 348M*;  0.96V  348M */
	status = "disabled"; // Disable NPU
};

/* UART0: Debug/main UART interface connected to connector J4 (PH9/PH10) */
&uart0 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart0_pins_active>;
	pinctrl-1 = <&uart0_pins_sleep>;
	status = "okay";
};

/* UART1: Connected to LTE modem (PE6/PE7) */
&uart1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart1_pins_active>;
	pinctrl-1 = <&uart1_pins_sleep>;
	status = "okay";
};

/* UART2: User interface accessible through connector J3 (PE12/PE13) */
&uart2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart2_pins_active>;
	pinctrl-1 = <&uart2_pins_sleep>;
	status = "okay";
};

/* UART3: Disabled - not used */
&uart3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart3_pins_active>;
	pinctrl-1 = <&uart3_pins_sleep>;
	status = "disabled";
};

&pio {
	/* GPIO control pins configuration */
	gpio_control_pins_a: gpio-control-a@0 {
		allwinner,pins = "PA8", "PA9";
		allwinner,function = "gpio_out";
		allwinner,muxsel = <1>;
		allwinner,drive = <1>;
		allwinner,pull = <0>;
	};

	gpio_control_pins_e: gpio-control-e@0 {
		allwinner,pins = "PE3", "PE4", "PE11";
		allwinner,function = "gpio_out";
		allwinner,muxsel = <1>;
		allwinner,drive = <1>;
		allwinner,pull = <0>;
	};

	/* GPIO LED pins configuration */
	gpio_led_pins: gpio-led-pins@0 {
		allwinner,pins = "PF1", "PF4", "PF6";
		allwinner,function = "gpio_out";
		allwinner,muxsel = <1>;
		allwinner,drive = <1>;
		allwinner,pull = <0>;
	};

	/* GPIO input pins configuration (status signals) */
	gpio_input_pins_e: gpio-input-e@0 {
		allwinner,pins = "PE0", "PE2", "PE5", "PE8", "PE9";
		allwinner,function = "gpio_in";
		allwinner,muxsel = <0>;
		allwinner,drive = <0>;
		allwinner,pull = <1>; /* Pull-up for stable readings */
	};

	gpio_input_pins_f: gpio-input-f@0 {
		allwinner,pins = "PF3";
		allwinner,function = "gpio_in";
		allwinner,muxsel = <0>;
		allwinner,drive = <0>;
		allwinner,pull = <1>; /* Pull-up for stable readings */
	};

	gpio_input_pins_h: gpio-input-h@0 {
		allwinner,pins = "PH0";
		allwinner,function = "gpio_in";
		allwinner,muxsel = <0>;
		allwinner,drive = <0>;
		allwinner,pull = <1>; /* Pull-up for stable readings */
	};

	usb_vbus_pins: usb-vbus@0 {
    allwinner,pins = "PH13";
    allwinner,function = "gpio_in";
    allwinner,muxsel = <0>;
    allwinner,drive = <0>;
    allwinner,pull = <1>; /* Pull-up for VBUS detection */
	};

	/* UART0: Debug/main UART (PH9/PH10) */
	uart0_pins_active: uart0@0 {
		allwinner,pins = "PH9", "PH10";
		allwinner,function = "uart0";
		allwinner,muxsel = <5>;
		allwinner,drive = <1>;
		allwinner,pull = <1>;
	};

	uart0_pins_sleep: uart0@1 {
		allwinner,pins = "PH9", "PH10";
		allwinner,function = "gpio_in";
		allwinner,muxsel = <0>;
	};

	/* UART1: LTE Modem interface (PE6/PE7) */
	uart1_pins_active: uart1@0 {
		allwinner,pins = "PE6", "PE7";
		allwinner,function = "uart1";
		allwinner,muxsel = <6>;
		allwinner,drive = <1>;
		allwinner,pull = <1>;
	};

	uart1_pins_sleep: uart1@1 {
		allwinner,pins = "PE6", "PE7";
		allwinner,function = "gpio_in";
		allwinner,muxsel = <0>;
	};

	/* UART2: User interface (PE12/PE13) */
	uart2_pins_active: uart2@0 {
		allwinner,pins = "PE12", "PE13";
		allwinner,function = "uart2";
		allwinner,muxsel = <6>;
		allwinner,drive = <1>;
		allwinner,pull = <1>;
	};

	uart2_pins_sleep: uart2@1 {
		allwinner,pins = "PE12", "PE13";
		allwinner,function = "gpio_in";
		allwinner,muxsel = <0>;
	};

	uart3_pins_active: uart3@0 {
		allwinner,pins = "PH0", "PH1";
		allwinner,function = "uart3";
		allwinner,muxsel = <5>;
		allwinner,drive = <1>;
		allwinner,pull = <1>;
	};

	uart3_pins_sleep: uart3@1 {
		allwinner,pins = "PH0", "PH1";
		allwinner,function = "gpio_in";
		allwinner,muxsel = <0>;
	};

	/* SPI0: Flash Memory interface (PC0-PC5) */
	spi0_pins_a: spi0@0 {
		allwinner,pins = "PC0", "PC2", "PC3";
		allwinner,pname = "spi0_sclk", "spi0_mosi", "spi0_miso";
		allwinner,function = "spi0";
		allwinner,muxsel = <4>;
		allwinner,drive = <1>;
		allwinner,pull = <0>;
	};

	spi0_pins_b: spi0@1 {
		allwinner,pins = "PC1", "PC5", "PC4";
		allwinner,pname = "spi0_cs0", "spi0_hold", "spi0_wp";
		allwinner,function = "spi0";
		allwinner,muxsel = <4>;
		allwinner,drive = <1>;
		allwinner,pull = <1>;   // only CS should be pulled up
	};

	spi0_pins_c: spi0@2 {
		allwinner,pins = "PC0", "PC1", "PC2", "PC3", "PC4", "PC5";
		allwinner,function = "io_disabled";
		allwinner,muxsel = <7>;
		allwinner,drive = <1>;
		allwinner,pull = <0>;
	};

	/* TWI2: I2C interface for Microcontroller, Accelerometer, RTC and 1Wire (PH11/PH12) */
	twi2_pins_a: twi2@0 {
		allwinner,pins = "PH11", "PH12";
		allwinner,pname = "twi2_scl", "twi2_sda";
		allwinner,function = "twi2";
		allwinner,muxsel = <5>;
		allwinner,drive = <0>;
		allwinner,pull = <0>;
	};

	twi2_pins_b: twi2@1 {
		allwinner,pins = "PH11", "PH12";
		allwinner,function = "io_disabled";
		allwinner,muxsel = <0xf>;
		allwinner,drive = <0>;
		allwinner,pull = <0>;
	};
};

/* SPI0: Flash Memory interface - Disabled (handled by U-Boot) */
&spi0 {
	clock-frequency = <100000000>;
	pinctrl-0 = <&spi0_pins_a &spi0_pins_b>;
	pinctrl-1 = <&spi0_pins_c>;
	pinctrl-names = "default", "sleep";
	spi_slave_mode = <0>;
	spi_dbi_enable = <0>;
	spi0_cs_number = <1>;
	status = "disabled";

	spi_board0 {
		device_type = "spi_board0";
		compatible = "spi-nor";
		spi-max-frequency = <0x05F5E100>;
		m25p,fast-read = <1>;
		/*individual_lock;*/
		reg = <0x0>;
		spi-rx-bus-width=<0x04>;
		spi-tx-bus-width=<0x04>;
		status="disabled";
	};

	spi-nand@0 {
		compatible = "spi-nand";
		spi-max-frequency=<0x05F5E100>;
		reg = <0x0>;
		spi-rx-bus-width=<0x04>;
		spi-tx-bus-width=<0x04>;
		status="disabled";
	};
};

/* Disable SPI1 - not used */
&spi1 {
	status = "disabled";
};

/* Disable SPI5/SPIF - not used */
&spi5 {
	status = "disabled";
};

/* Disable TWI0 - not used */
&twi0 {
	status = "disabled";
};

/* Disable TWI1 - not used */
&twi1 {
	status = "disabled";
};

/* TWI2: Enable for Microcontroller, Accelerometer, RTC and 1Wire */
&twi2 {
	clock-frequency = <100000>;
	pinctrl-0 = <&twi2_pins_a>;
	pinctrl-1 = <&twi2_pins_b>;
	pinctrl-names = "default", "sleep";
	/* For stability and backwards compatibility, we recommend setting 'twi_drv_used' to 0  */
	twi_drv_used = <0>;
	twi_pkt_interval = <0>;
	status = "okay";

	/* FRTC8563M - I2C RTC at 0x51 */
	rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		status = "okay";
	};

	/* LIS2HH12TR - Accelerometer at 0x1e */
	// accelerometer@1e {
	// 	compatible = "st,lis2hh12";
	// 	reg = <0x1e>;
	// 	interrupt-parent = <&pio>;
	// 	interrupts = <PH 0 IRQ_TYPE_EDGE_RISING>, /* ACCEL_INT1 */
	// 		     <PF 3 IRQ_TYPE_EDGE_RISING>; /* ACCEL_INT2 */
	// 	interrupt-names = "INT1", "INT2";
	// 	status = "okay";
	// };

	/* DS2482S - I2C to 1-Wire Bridge at 0x18 */
	// w1@18 {
	// 	compatible = "maxim,ds2482";
	// 	reg = <0x18>;
	// 	status = "okay";
	// };
};

/* Disable TWI3 - not used */
&twi3 {
	status = "disabled";
};

/* Disable TWI4 - not used */
&twi4 {
	status = "disabled";
};

/* Disable audio codec - not used */
&codec {
	status = "disabled";
};

&codec_plat {
	status = "disabled";
};

&codec_mach {
	status = "disabled";
};

/* Disable DMIC - not used */
&dmic_plat {
	status = "disabled";
};

&dmic_mach {
	status = "disabled";
};

/* Disable I2S/PCM - not used */
&daudio0_plat {
	status = "disabled";
};

&daudio0_mach {
	status = "disabled";
};

&daudio1_plat {
	status = "disabled";
};

&daudio1_mach {
	status = "disabled";
};

/* USB configuration - Enable USB interface as HOST mode */
&usbc0 {
	device_type = "usbc0";
	usb_port_type = <0x01>;
	usb_detect_type = <0x1>;
	usb_detect_mode = <0x01>;
	usb_id_gpio;
	usb_det_vbus_gpio;
	usb_force_interface = <0x01>;   /* Force interface: 1=host, 0=device (if supported) */
	usb_det_vbus_gpio = <&pio PH 13 0 1 2 0>; /* PH13 for VBUS detection */
	pinctrl-names = "default";
    pinctrl-0 = <&usb_vbus_pins>;
	usb_regulator_io = "nocare";
	usb_wakeup_suspend = <0x0>;
	usb_luns = <0x3>;
	usb_serial_unique = <0x0>;
	usb_serial_number = "20080411";
	status = "okay";
};

&ehci0 {
    status = "okay";
};

&ohci0 {
    status = "okay";
};

&udc {
	status = "disabled";
};

/* Disable PWM modules - not used */
&pwm4 {
	status = "disabled";
};

&pwm6 {
	status = "disabled";
};

&pwm7 {
	status = "disabled";
};

&pwm11 {
	status = "disabled";
};

&pwm {
	status = "disabled";
};

/* Disable GPADC - not used */
&gpadc {
	status = "disabled";
};

/* Disable Wiegand - not used */
&wiegand {
	status = "disabled";
};

/* Disable Ethernet - not used */
&gmac0{
	status = "disabled";
};

/* Disable all SD/MMC interfaces - not used in your configuration */
&sdc0 {
	status = "disabled";
};

&sdc1 {
	status = "disabled";
};

&sdc2 {
	status = "disabled";
};

&cpu0 {
	vf_tbl_sel = <0>;
};
