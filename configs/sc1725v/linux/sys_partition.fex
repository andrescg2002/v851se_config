;---------------------------------------------------------------------------------------------------------
; Note: Strings in the script are case-sensitive. Users can modify the value after "=",
;       but should not modify the string preceding it.
;---------------------------------------------------------------------------------------------------------

;--------------------------------------------------------------------------------------------------
;                                   Firmware download parameter configuration
;--------------------------------------------------------------------------------------------------
;****************************************************
;    The size of the MBR, in kilobytes.
;****************************************************
[mbr]
size = 4096

;********************************************************************************************************
;                                              Partition Configuration
;
;
;  Partition Definition Example:
;    [partition]                ; // Indicates this is a partition
;    name        = USERFS2      ; // Partition name
;    size        = 16384        ; // Partition size in sectors. Max partition count: 2^31 * 512 = 2TB
;    downloadfile = "123.fex"   ; // Download file path and name. Can use relative path (relative to image.cfg file location) or absolute path
;    keydata     = 1            ; // Private data partition - data will not be lost during re-production
;    encrypt     = 1            ; // Use encrypted burning method - provides data encryption but reduces burning speed
;    user_type   = ?            ; // Private usage type
;    verify      = 1            ; // Requires verification after production completion
;
; Notes: 1. Name must be unique - no duplicate names allowed
;        2. Name maximum 12 characters
;        3. size = 0 will create an empty partition with no size
;        4. For security and efficiency, partition size should preferably be multiples of 16MB
;********************************************************************************************************
[partition_start]

[partition]
    name         = boot-resource
    size         = 512
    downloadfile = "boot-resource.fex"
    user_type    = 0x8000

[partition]
    name         = env
    size         = 512
    downloadfile = "env.fex"
    user_type    = 0x8000

[partition]
    name         = boot
    ;size        = 4096
    size         = 10240
    downloadfile = "boot.fex"
    user_type    = 0x8000

[partition]
    name         = rootfs
    size         = 16384
    downloadfile = "rootfs.fex"
    user_type    = 0x8000

[partition]
    name         = rootfs_data
    size         = 16384
    user_type    = 0x8000

[partition]
    name         = private
    size         = 512
    user_type    = 0x8000
    keydata     = 1
    encrypt     = 1


[partition]
    name         = UDISK
    user_type    = 0x8100
